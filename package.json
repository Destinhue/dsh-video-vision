{
  "name": "dsh-video-vision",
  "version": "1.4.0",
  "description": "Look at a video, not a summary of it: one addressable storyboard grid per view, tuned for deepseek-v4.1-flash vision — adaptive cell resolution, content-aware layout, frame-level scene detection and a token-tight index. Reads a lecture as a timestamped text document, maps a whole file as text with no image at all, and turns an audio-only file into a transcript.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "storyboard",
    "contact-sheet",
    "ffmpeg",
    "multimodal",
    "vision",
    "deepseek-v4.1-flash"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./scan": "./src/scan.js",
    "./layout": "./src/layout.js",
    "./sheet": "./src/sheet.js",
    "./media": "./src/media.js",
    "./pipeline": "./src/pipeline.js",
    "./manifest": "./src/manifest.js",
    "./outline": "./src/outline.js",
    "./read": "./src/read.js",
    "./ocr": "./src/ocr.js",
    "./asr": "./src/asr.js"
  },
  "files": [
    "src",
    "bin",
    "test",
    "docs",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "screenshots.json",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dsh-video-vision-install": "bin/install.mjs",
    "dsh-video-vision-selfcheck": "bin/selfcheck.mjs"
  },
  "scripts": {
    "test": "node --test test/",
    "selfcheck": "node bin/selfcheck.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Destinhue/dsh-video-vision.git"
  },
  "homepage": "https://github.com/Destinhue/dsh-video-vision#readme",
  "bugs": {
    "url": "https://github.com/Destinhue/dsh-video-vision/issues"
  }
}
